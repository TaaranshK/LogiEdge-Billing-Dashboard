# Backend Environment Variables - Example/Template
# ================================================
# For Supabase PostgreSQL connection, use these settings:
# Get your connection string from: Supabase Dashboard → Project → Database → Connection strings → URI

# Server Configuration
PORT=5000

# DATABASE CONFIGURATION FOR SUPABASE POSTGRESQL
# Get these values from: Project Settings → Database → Connection strings
DB_HOST=db.YOUR-PROJECT-ID.supabase.co
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=your-supabase-password

# Node Environment
NODE_ENV=development

# Example for local PostgreSQL (if testing locally):
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=logiedge_billing
# DB_USER=postgres
# DB_PASSWORD=postgres
